# dependencies / builds
node_modules/
dist/
build/
target/
.venv/
__pycache__/
*.pyc

# local models and audio are never committed
models/
*.gguf
*.bin
*.onnx
recordings/
*.wav
*.mp3
*.m4a

# local state
.env
*.local.json
.DS_Store
Thumbs.db

# session logs and backtest maps stay on the device
sessions/

# the extension ships its runtime files
!extension/vendor/*.onnx

# Chrome writes this into an unpacked extension folder
extension/_metadata/
