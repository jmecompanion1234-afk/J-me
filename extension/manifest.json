{
  "manifest_version": 3,
  "name": "J-me",
  "version": "0.2.0",
  "description": "A switch on any tab: J-me listens to the video or call playing there and keeps the searches and prompts it is about to need, as an overlay on the page. Everything runs in the browser.",
  "minimum_chrome_version": "128",
  "action": {
    "default_title": "J-me: listen to this tab"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://html.duckduckgo.com/*",
    "http://127.0.0.1:11434/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
